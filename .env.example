# Better Auth
BETTER_AUTH_URL=https://ephraimduncan.com
BETTER_AUTH_TRUSTED_ORIGINS=https://ephraimduncan.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://ephraimduncan.com

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn follower count (server-only; never use a VITE_ prefix)
# Preferred: official Member Follower Statistics API access token
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_VERSION=202609

# Optional scraper-provider fallback for LinkedIn HTTP 999 responses.
# Set only as a server-side secret; requests use the public profile handle above.
CHOCODATA_API_KEY=

# Optional scrape fallback: LinkedIn session cookie (powerful login credential).
# Set only as a server-side deployment secret. Never commit it or expose it to the browser.
LINKEDIN_LI_AT_COOKIE=
